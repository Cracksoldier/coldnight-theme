<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="archive-wrapper">
  <main id="main-content" role="main">

    <header class="page-header">
      <h1>Archive</h1>
      <p class="page-header__meta"><%= page.posts.length %> posts</p>
    </header>

    <%
      const _cats = [], _tags = [], _catSeen = new Set(), _tagSeen = new Set()
      page.posts.each(p => {
        if (p.categories && p.categories.length) {
          const c = p.categories.first().name
          if (!_catSeen.has(c)) { _catSeen.add(c); _cats.push(c) }
        }
        if (p.tags) p.tags.each(t => {
          if (!_tagSeen.has(t.name)) { _tagSeen.add(t.name); _tags.push(t.name) }
        })
      })
      _cats.sort(); _tags.sort()

      const postsByYear = {}
      page.posts.each(post => {
        const year = post.date.year()
        if (!postsByYear[year]) postsByYear[year] = []
        postsByYear[year].push(post)
      })
      const years = Object.keys(postsByYear).sort((a, b) => b - a)
    %>

    <% if (_cats.length || _tags.length) { %>
    <div class="archive-filters" role="group" aria-label="Filter posts">
      <button class="archive-filter-chip archive-filter-chip--active" data-filter-type="all" aria-pressed="true">All</button>
      <% _cats.forEach(c => { %>
        <button class="archive-filter-chip" data-filter-type="category" data-filter-value="<%= c %>" aria-pressed="false"><%= c %></button>
      <% }) %>
      <% _tags.forEach(t => { %>
        <button class="archive-filter-chip" data-filter-type="tag" data-filter-value="<%= t %>" aria-pressed="false">#<%= t %></button>
      <% }) %>
    </div>
    <% } %>

    <% years.forEach(year => { %>
      <section class="archive-year-group">
        <h2 class="archive-year"><%= year %></h2>
        <ul class="archive-items">
          <% postsByYear[year].forEach(post => { %>
            <li class="archive-item"
                data-category="<%= post.categories && post.categories.length ? post.categories.first().name : '' %>"
                data-tags="<%= post.tags && post.tags.length ? post.tags.toArray().map(t => t.name).join('|') : '' %>">
              <time class="archive-item__date" datetime="<%= post.date.format('YYYY-MM-DD') %>">
                <%= post.date.format('MMM D') %>
              </time>
              <a href="<%- url_for(post.path) %>" class="archive-item__title"><%= post.title %></a>
              <span class="archive-item__meta">
                <% if (post.categories && post.categories.length) { %>
                  <%= post.categories.toArray()[0].name %><% if (theme.reading_time !== false) { %> &middot; <%= reading_time(post.content) %><% } %>
                <% } else if (theme.reading_time !== false) { %>
                  <%= reading_time(post.content) %>
                <% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>

  </main>
</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<script src="<%- url_for('/js/archive-filter.js') %>" defer></script>

</body>
</html>
