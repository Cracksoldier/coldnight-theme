<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="page-wrapper">

  <main class="main-content" id="main-content" role="main">

    <%
      const gridCols   = (theme.grid && theme.grid.columns) || 3
      const tabletCols = Math.max(1, Math.ceil(gridCols / 2))
      const isList     = gridCols === 1

      // Pinned/featured post — hero on page 1 only
      const pinnedPost = pinned_post()
      const showHero   = !!pinnedPost && (page.current === 1 || !page.current)
    %>

    <% if (showHero) { %>
      <%- partial('_partial/pinned-post', { post: pinnedPost }) %>
    <% } %>

    <div class="post-grid<%= isList ? ' post-grid--list' : '' %>"
         style="--post-grid-cols: <%= gridCols %>; --post-grid-cols-md: <%= tabletCols %>;">
      <% page.posts.each(post => { %>
        <% if (showHero && post.path === pinnedPost.path) return %>
        <%- partial('_partial/post-card', { post }) %>
      <% }) %>
    </div>

    <%- partial('_partial/pagination') %>

  </main>

  <% if (!theme.sidebar || theme.sidebar.position !== 'hidden') { %>
    <%- partial('_partial/sidebar') %>
  <% } %>

</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<script src="<%- url_for('/js/copy-code.js') %>" defer></script>

</body>
</html>
