<%
  const lgEnabled = theme.lightgallery && theme.lightgallery.enabled
  const lgAutoMount = lgEnabled && theme.lightgallery.auto_mount
  const lgZoom = lgEnabled && theme.lightgallery.zoom
  const lgThumb = lgEnabled && theme.lightgallery.thumbnail

  // Related posts — score by shared tags (2 pts each) + same category (1 pt)
  const _relatedTagSet = new Set()
  if (page.tags) page.tags.each(t => _relatedTagSet.add(t.name))
  const _relatedCat = page.categories && page.categories.length
    ? page.categories.first().name : null

  const _relatedCandidates = []
  site.posts.each(p => {
    if (p.path === page.path) return
    let score = 0
    if (p.tags) p.tags.each(t => { if (_relatedTagSet.has(t.name)) score += 2 })
    if (_relatedCat && p.categories && p.categories.length &&
        p.categories.first().name === _relatedCat) score += 1
    if (score > 0) _relatedCandidates.push({ post: p, score })
  })
  _relatedCandidates.sort((a, b) => b.score - a.score)
  const relatedPosts = _relatedCandidates.slice(0, 3).map(x => x.post)

  // Series nav — group posts sharing the same `series:` front-matter value
  const _seriesName = page.series || null
  let seriesPosts = []
  let seriesIndex = 0
  if (_seriesName && theme.series !== false) {
    const _seriesCandidates = []
    site.posts.each(p => { if (p.series === _seriesName) _seriesCandidates.push(p) })
    _seriesCandidates.sort((a, b) => a.date - b.date)
    seriesIndex = _seriesCandidates.findIndex(p => p.path === page.path) + 1
    seriesPosts = _seriesCandidates
  }
%>
<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<% if (theme.progress_bar) { %>
<div id="reading-progress" class="reading-progress" role="progressbar"
     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Reading progress"></div>
<% } %>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="page-wrapper">

  <main class="main-content post-page" id="main-content" role="main">

    <article>

      <header class="post-header">
        <h1 class="post-title"><%= page.title %></h1>

        <div class="post-meta">
          <time datetime="<%= page.date.toISOString() %>">
            <%= date(page.date, 'DD.MM.YYYY') %>
          </time>

          <% if (page.updated && page.updated.format('YYYY-MM-DD') !== page.date.format('YYYY-MM-DD')) { %>
          <time class="post-updated" datetime="<%= page.updated.toISOString() %>"
                title="Last updated">↻ Updated <%= date(page.updated, 'DD.MM.YYYY') %></time>
          <% } %>

          <% if (config.author) { %>
            <span><%= config.author %></span>
          <% } %>

          <% if (theme.reading_time) { %>
            <span><%= reading_time(page.content) %></span>
          <% } %>

          <% if (theme.word_count) { %>
            <span><%= word_count(page.content) %></span>
          <% } %>

          <% if (page.categories && page.categories.length) { %>
            <% page.categories.each(cat => { %>
              <a href="<%- url_for(cat.path) %>" class="tag-pill"><%= cat.name %></a>
            <% }) %>
          <% } %>

          <% if (theme.permalink_button !== false) { %>
            <button class="btn btn--icon btn--sm post-permalink-btn"
                    data-permalink="<%= page.permalink %>"
                    aria-label="Copy link to post"
                    title="Copy permalink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
              </svg>
            </button>
          <% } %>
          <% if (theme.epub_export !== false) { %>
            <button class="btn btn--icon btn--sm epub-export-btn"
                    data-title="<%= page.title %>"
                    data-author="<%= config.author || '' %>"
                    data-url="<%= page.permalink %>"
                    data-slug="<%= page.slug %>"
                    data-language="<%= config.language || 'en' %>"
                    aria-label="Export as ePub"
                    title="Download as ePub">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/>
              </svg>
            </button>
          <% } %>
        </div>
      </header>

      <% if (page.cover_image) { %>
        <% if (page.cover_caption) { %>
        <figure class="post-cover-figure">
          <img src="<%- url_for(page.cover_image) %>" alt=""
               class="post-cover" loading="lazy">
          <figcaption><%= page.cover_caption %></figcaption>
        </figure>
        <% } else { %>
        <img src="<%- url_for(page.cover_image) %>" alt="<%= page.title %>"
             class="post-cover" loading="lazy">
        <% } %>
      <% } %>

      <% if (seriesPosts.length > 1 && seriesIndex > 0) { %>
      <nav class="series-nav" aria-label="<%= page.series %> series">
        <div class="series-nav__header">
          <span class="series-nav__badge">Series</span>
          <span class="series-nav__name"><%= page.series %></span>
          <span class="series-nav__progress">Part <%= seriesIndex %> of <%= seriesPosts.length %></span>
        </div>
        <ol class="series-nav__list">
          <% seriesPosts.forEach(p => { %>
            <li class="series-nav__item<%= p.path === page.path ? ' series-nav__item--active' : '' %>">
              <% if (p.path === page.path) { %>
                <span><%= p.title %></span>
              <% } else { %>
                <a href="<%- url_for(p.path) %>"><%= p.title %></a>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </nav>
      <% } %>

      <% if (page.abstract) { %>
      <%- partial('_partial/post-abstract') %>
      <% } %>

      <div class="post-body prose">
        <%- page.content %>
      </div>

      <footer class="post-footer">

        <% if (page.tags && page.tags.length) { %>
          <div class="post-tags">
            <% page.tags.each(tag => { %>
              <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
            <% }) %>
          </div>
        <% } %>

        <% if (theme.social && theme.social.share) { %>
        <div class="post-share">
          <span class="post-share__label">Share</span>
          <div class="post-share__btns">
            <a class="btn btn--ghost btn--sm"
               href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(page.title) %>&url=<%= encodeURIComponent(page.permalink) %>"
               target="_blank" rel="noopener noreferrer">X / Twitter</a>
            <a class="btn btn--ghost btn--sm"
               href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(page.permalink) %>"
               target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <button class="btn btn--ghost btn--sm post-share-copy"
                    data-permalink="<%= page.permalink %>">Copy link</button>
          </div>
        </div>
        <% } %>

        <nav class="post-nav" aria-label="Post navigation">
          <div class="post-nav__item post-nav__item--prev">
            <% if (page.prev) { %>
              <span class="post-nav__label">← Previous</span>
              <a href="<%- url_for(page.prev.path) %>" class="post-nav__title"><%= page.prev.title %></a>
            <% } %>
          </div>
          <div class="post-nav__item post-nav__item--next">
            <% if (page.next) { %>
              <span class="post-nav__label">Next →</span>
              <a href="<%- url_for(page.next.path) %>" class="post-nav__title"><%= page.next.title %></a>
            <% } %>
          </div>
        </nav>

      </footer>

    </article>

    <% if (theme.related_posts && relatedPosts.length) { %>
    <section class="related-posts" aria-labelledby="related-heading">
      <h3 class="related-posts__heading" id="related-heading">You might also like</h3>
      <div class="post-grid" style="--post-grid-cols: <%= Math.min(relatedPosts.length, 2) %>; --post-grid-cols-md: <%= Math.min(relatedPosts.length, 2) %>;">
        <% relatedPosts.forEach(post => { %>
          <%- partial('_partial/post-card', { post }) %>
        <% }) %>
      </div>
    </section>
    <% } %>

  </main>

  <% if (!theme.sidebar || theme.sidebar.position !== 'hidden') { %>
    <%- partial('_partial/sidebar') %>
  <% } %>

</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>
<% if (theme.toc && theme.toc.enabled) { %>
<%- partial('_partial/toc-drawer') %>
<% } %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<script src="<%- url_for('/js/copy-code.js') %>" defer></script>
<% if (theme.toc && theme.toc.enabled) { %>
<script src="<%- url_for('/js/toc.js') %>" defer></script>
<script src="<%- url_for('/js/toc-drawer.js') %>" defer></script>
<% } %>
<% if (theme.sticky_title) { %>
<script src="<%- url_for('/js/post-title.js') %>" defer></script>
<% } %>
<% if (theme.progress_bar) { %>
<script src="<%- url_for('/js/reading-progress.js') %>" defer></script>
<% } %>
<script src="<%- url_for('/js/post-nav-keys.js') %>" defer></script>
<% if (theme.epub_export !== false) { %>
<script src="<%- url_for('/vendor/jszip/jszip.min.js') %>" defer></script>
<script src="<%- url_for('/js/epub-export.js') %>" defer></script>
<% } %>
<% if (theme.pdf_viewer !== false) { %>
<script src="<%- url_for('/js/pdf-viewer.js') %>" defer></script>
<% } %>

<% if (lgEnabled) { %>
  <script src="<%- url_for('/vendor/lightgallery/lightgallery.umd.js') %>" defer></script>
  <% if (lgZoom) { %>
  <script src="<%- url_for('/vendor/lightgallery/lg-zoom.umd.js') %>" defer></script>
  <% } %>
  <% if (lgThumb) { %>
  <script src="<%- url_for('/vendor/lightgallery/lg-thumbnail.umd.js') %>" defer></script>
  <% } %>
  <% if (lgAutoMount) { %>
  <script src="<%- url_for('/js/gallery.js') %>" defer></script>
  <% } %>
<% } %>
<% if (theme.mermaid && theme.mermaid.enabled) { %>
<script type="module">
  import mermaid from '<%- url_for('/vendor/mermaid/mermaid.esm.min.mjs') %>';
  mermaid.initialize({ startOnLoad: true, theme: '<%= /^[a-z]+$/.test(theme.mermaid.theme) ? theme.mermaid.theme : "dark" %>' });
</script>
<% } %>
<% if (theme.model_viewer && theme.model_viewer.enabled !== false && page.content && page.content.includes('class="model-viewer"')) { %>
<script type="module">
  import * as THREE from '<%- url_for('/vendor/three/three.module.min.js') %>';
  import { GLTFLoader } from '<%- url_for('/vendor/three/GLTFLoader.js') %>';
  import { STLLoader } from '<%- url_for('/vendor/three/STLLoader.js') %>';
  import { OrbitControls } from '<%- url_for('/vendor/three/OrbitControls.js') %>';
  window.__THREE_VIEWER__ = { THREE, GLTFLoader, STLLoader, OrbitControls };
  window.dispatchEvent(new Event('three-viewer-ready'));
</script>
<script src="<%- url_for('/js/model-viewer.js') %>" defer></script>
<% } %>

</body>
</html>
