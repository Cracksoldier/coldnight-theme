<%
  const lgEnabled = theme.lightgallery && theme.lightgallery.enabled
  const lgAutoMount = lgEnabled && theme.lightgallery.auto_mount
  const lgZoom = lgEnabled && theme.lightgallery.zoom
  const lgThumb = lgEnabled && theme.lightgallery.thumbnail

  // Related posts — score by shared tags (2 pts each) + same category (1 pt)
  const _relatedTagSet = new Set()
  if (page.tags) page.tags.each(t => _relatedTagSet.add(t.name))
  const _relatedCat = page.categories && page.categories.length
    ? page.categories.first().name : null

  const _relatedCandidates = []
  site.posts.each(p => {
    if (p.path === page.path) return
    let score = 0
    if (p.tags) p.tags.each(t => { if (_relatedTagSet.has(t.name)) score += 2 })
    if (_relatedCat && p.categories && p.categories.length &&
        p.categories.first().name === _relatedCat) score += 1
    if (score > 0) _relatedCandidates.push({ post: p, score })
  })
  _relatedCandidates.sort((a, b) => b.score - a.score)
  const relatedPosts = _relatedCandidates.slice(0, 3).map(x => x.post)
%>
<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<% if (theme.progress_bar) { %>
<div id="reading-progress" class="reading-progress" role="progressbar"
     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Reading progress"></div>
<% } %>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="page-wrapper">

  <main class="main-content post-page" id="main-content" role="main">

    <article>

      <header class="post-header">
        <h1 class="post-title"><%= page.title %></h1>

        <div class="post-meta">
          <time datetime="<%= page.date.toISOString() %>">
            <%= date(page.date, 'YYYY-MM-DD') %>
          </time>

          <% if (config.author) { %>
            <span><%= config.author %></span>
          <% } %>

          <% if (theme.reading_time) { %>
            <span><%= reading_time(page.content) %></span>
          <% } %>

          <% if (page.categories && page.categories.length) { %>
            <% page.categories.each(cat => { %>
              <a href="<%- url_for(cat.path) %>" class="tag-pill"><%= cat.name %></a>
            <% }) %>
          <% } %>
        </div>
      </header>

      <% if (page.cover_image) { %>
        <img src="<%= page.cover_image %>" alt="" class="post-cover" loading="lazy">
      <% } %>

      <div class="post-body prose">
        <%- page.content %>
      </div>

      <footer class="post-footer">

        <% if (page.tags && page.tags.length) { %>
          <div class="post-tags">
            <% page.tags.each(tag => { %>
              <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
            <% }) %>
          </div>
        <% } %>

        <nav class="post-nav" aria-label="Post navigation">
          <div class="post-nav__item post-nav__item--prev">
            <% if (page.prev) { %>
              <span class="post-nav__label">← Previous</span>
              <a href="<%- url_for(page.prev.path) %>" class="post-nav__title"><%= page.prev.title %></a>
            <% } %>
          </div>
          <div class="post-nav__item post-nav__item--next">
            <% if (page.next) { %>
              <span class="post-nav__label">Next →</span>
              <a href="<%- url_for(page.next.path) %>" class="post-nav__title"><%= page.next.title %></a>
            <% } %>
          </div>
        </nav>

      </footer>

    </article>

    <% if (theme.related_posts && relatedPosts.length) { %>
    <section class="related-posts" aria-labelledby="related-heading">
      <h3 class="related-posts__heading" id="related-heading">You might also like</h3>
      <div class="post-grid" style="--post-grid-cols: 2; --post-grid-cols-md: 2;">
        <% relatedPosts.forEach(post => { %>
          <%- partial('_partial/post-card', { post }) %>
        <% }) %>
      </div>
    </section>
    <% } %>

  </main>

  <% if (!theme.sidebar || theme.sidebar.position !== 'hidden') { %>
    <%- partial('_partial/sidebar') %>
  <% } %>

</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<script src="<%- url_for('/js/copy-code.js') %>" defer></script>
<% if (theme.toc && theme.toc.enabled && (!theme.sidebar || theme.sidebar.position !== 'hidden')) { %>
<script src="<%- url_for('/js/toc.js') %>" defer></script>
<% } %>
<% if (theme.progress_bar) { %>
<script src="<%- url_for('/js/reading-progress.js') %>" defer></script>
<% } %>

<% if (lgEnabled) { %>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2/lightgallery.umd.min.js" defer></script>
  <% if (lgZoom) { %>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2/plugins/zoom/lg-zoom.umd.min.js" defer></script>
  <% } %>
  <% if (lgThumb) { %>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2/plugins/thumbnail/lg-thumbnail.umd.min.js" defer></script>
  <% } %>
  <% if (lgAutoMount) { %>
  <script src="<%- url_for('/js/gallery.js') %>" defer></script>
  <% } %>
<% } %>

</body>
</html>
