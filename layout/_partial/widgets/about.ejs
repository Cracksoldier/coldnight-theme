<%
  const social = theme.social || {}
  const sidebar = theme.sidebar || {}
  // Non-string config values (bare YAML booleans/numbers) are ignored, not
  // stringified — same posture as cfgStr in _partial/header.ejs.
  const cfgStr = v => (typeof v === 'string' ? v.trim() : '')
  // A bare `false` — or the string a quoted YAML value produces — suppresses
  // the line outright; same posture as cover.fallback.
  const off = v => v === false || v === 'false'

  const widgetTitle = cfgStr(sidebar.about_title) || 'About'
  const name = off(sidebar.about_name) ? '' : (cfgStr(sidebar.about_name) || cfgStr(config.author))
  const bio = off(sidebar.about_description) ? '' : (cfgStr(sidebar.about_description) || cfgStr(config.description))
  const avatar = cfgStr(config.avatar)

  const hasContent = [name, bio, avatar, social.github, social.twitter]
    .some(v => cfgStr(v) !== '')
%>
<% if (hasContent) { %>
<div class="sidebar-widget widget-about">
  <p class="sidebar-widget__title"><%= widgetTitle %></p>
  <% if (avatar) { %>
    <img class="widget-about__avatar" src="<%= avatar %>" alt="<%= name %>">
  <% } %>
  <% if (name) { %>
    <p class="widget-about__name"><%= name %></p>
  <% } %>
  <% if (bio) { %>
    <p class="widget-about__bio"><%= bio %></p>
  <% } %>
  <div class="widget-about__social">
    <% if (theme.social && theme.social.github) { %>
      <a href="https://github.com/<%= theme.social.github %>" target="_blank" rel="noopener noreferrer">GitHub</a>
    <% } %>
    <% if (theme.social && theme.social.twitter) { %>
      <a href="https://twitter.com/<%= theme.social.twitter %>" target="_blank" rel="noopener noreferrer">Twitter</a>
    <% } %>
  </div>
</div>
<% } %>
