<% const widgets = theme.sidebar && theme.sidebar.widgets ? theme.sidebar.widgets : [] %>
<% const aboutEnabled = !theme.sidebar || (theme.sidebar.about !== false && theme.sidebar.about !== 'false') %>

<aside class="sidebar" role="complementary" aria-label="Sidebar">
  <% widgets.forEach(widget => { %>
    <% if (widget === 'recent_posts') { %>
      <%- partial('widgets/recent-posts') %>
    <% } else if (widget === 'tags') { %>
      <%- partial('widgets/tag-cloud') %>
    <% } else if (widget === 'archives') { %>
      <%- partial('widgets/archive') %>
    <% } else if (widget === 'about') { %>
      <% if (aboutEnabled) { %>
        <%- partial('widgets/about') %>
      <% } %>
    <% } else if (widget === 'toc') { %>
      <% if (page.layout === 'post' && theme.toc && theme.toc.enabled) { %>
        <%- partial('widgets/toc') %>
      <% } %>
    <% } %>
  <% }) %>
</aside>
