<%
  const coverImg = resolve_cover(post)
  const category = post.categories && post.categories.length ? post.categories.first() : null
  const readTime = theme.reading_time ? reading_time(post.content) : ''
  const isLargeCover = coverImg ? large_cover(post) : false
%>
<article class="pinned-post fade-in<%= isLargeCover ? ' pinned-post--large' : '' %>">

  <span class="pinned-post__marker">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"/><path d="M9 3h6l1 7 2.5 3h-13L8 10z"/></svg>
    Pinned
  </span>

  <% if (coverImg) { %>
  <a href="<%- url_for(post.path) %>" class="pinned-post__cover" tabindex="-1" aria-hidden="true">
    <img src="<%- url_for(coverImg) %>" alt="" loading="eager" fetchpriority="high">
  </a>
  <% } %>

  <div class="pinned-post__body">
    <div class="pinned-post__meta">
      <% if (category) { %>
        <a href="<%- url_for(category.path) %>" class="post-card__category"<%- category_desc_attr(category.name) %>><%= category.name %></a>
      <% } %>
      <% if (readTime) { %><span><%= readTime %></span><% } %>
      <%- difficulty_meter(post) %>
    </div>

    <a href="<%- url_for(post.path) %>" class="pinned-post__title"><%= post.title %></a>

    <% if (post.excerpt) { %>
      <div class="pinned-post__excerpt"><%- post.excerpt %></div>
    <% } %>

    <div class="pinned-post__footer">
      <time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'DD.MM.YYYY') %></time>
      <a href="<%- url_for(post.path) %>" class="post-card__read-more">Read more →</a>
    </div>
  </div>

</article>
