<%
  const gc = theme.giscus
  const lang = (gc.lang || config.language || 'en').replace(/[^a-z-]/gi, '')
%>
<section class="giscus-wrap" aria-label="Comments">
  <h2 class="giscus-wrap__heading">Comments</h2>
  <script src="https://giscus.app/client.js"
    data-repo="<%= gc.repo %>"
    data-repo-id="<%= gc.repo_id %>"
    data-category="<%= gc.category %>"
    data-category-id="<%= gc.category_id %>"
    data-mapping="<%= ['pathname','url','title','og:title'].includes(gc.mapping) ? gc.mapping : 'pathname' %>"
    data-strict="0"
    data-reactions-enabled="<%= gc.reactions_enabled === false ? '0' : '1' %>"
    data-emit-metadata="0"
    data-input-position="<%= gc.input_position === 'top' ? 'top' : 'bottom' %>"
    data-theme="<%= /^[a-z_]+$/.test(gc.theme || '') || /^https?:\/\//.test(gc.theme || '') ? gc.theme : 'dark_dimmed' %>"
    data-lang="<%= lang %>"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</section>
