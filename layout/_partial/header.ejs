<% const navLinks = theme.navbar && theme.navbar.links ? theme.navbar.links : [] %>
<% const siteTitle = (theme.navbar && theme.navbar.title) || config.title %>

<header class="navbar" role="banner">
  <div class="navbar__inner">

    <!-- Brand -->
    <a href="<%- url_for('/') %>" class="navbar__brand" aria-label="<%= siteTitle %> — home">
      <svg class="navbar__logo" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="28" height="28" rx="6" fill="#050d1a"/>
        <path d="M8 20L14 8L20 20" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 16h8" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <span class="navbar__title"><%= siteTitle %></span>
    </a>

    <!-- Desktop nav -->
    <nav class="navbar__nav" aria-label="Main navigation" id="main-nav">
      <% navLinks.forEach(link => { %>
        <%
          const linkHref   = url_for(link.url).replace(/\/$/, '') || '/'
          const currentUrl = url_for('/' + page.path).replace(/\/index\.html$/, '').replace(/\/$/, '') || '/'
          const isActive   = currentUrl === linkHref
        %>
        <a href="<%- url_for(link.url) %>"
           class="nav-link<%= isActive ? ' active' : '' %>"
           <%= isActive ? 'aria-current="page"' : '' %>>
          <%= link.name %>
        </a>
      <% }) %>
    </nav>

    <!-- Actions -->
    <div class="navbar__actions">
      <% if (theme.sponsor && theme.sponsor.enabled && theme.sponsor.url) { %>
        <a href="<%= theme.sponsor.url %>" class="btn btn--coffee btn--sm" target="_blank" rel="noopener noreferrer">
          ☕ <%= theme.sponsor.label || 'Buy me a coffee' %>
        </a>
      <% } %>

      <!-- GitHub -->
      <% if (theme.social && theme.social.github) { %>
        <a href="https://github.com/<%= theme.social.github %>" class="btn btn--icon" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.167 6.839 9.49.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.091-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.03-2.683-.103-.253-.447-1.27.098-2.647 0 0 .84-.269 2.75 1.026A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.295 2.747-1.026 2.747-1.026.548 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.337 4.687-4.565 4.935.359.309.678.919.678 1.852 0 1.337-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
        </a>
      <% } %>

      <% if (theme.search && theme.search.enabled) { %>
      <div class="search-wrap navbar__search" id="search-wrap">
        <input type="search"
               class="search-input"
               id="search-input"
               placeholder="Search…"
               aria-label="Search posts"
               aria-expanded="false"
               aria-controls="search-results"
               autocomplete="off"
               spellcheck="false">
        <div class="search-results" id="search-results" role="listbox" aria-label="Search results"></div>
      </div>
      <% } %>

      <!-- Mobile hamburger -->
      <button class="btn btn--icon navbar__hamburger"
              id="nav-toggle"
              aria-expanded="false"
              aria-controls="mobile-nav"
              aria-label="Toggle navigation">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <line x1="2" y1="4.5" x2="16" y2="4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="2" y1="9" x2="16" y2="9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="2" y1="13.5" x2="16" y2="13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile nav drawer -->
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
  <% if (theme.search && theme.search.enabled) { %>
  <div class="search-wrap mobile-nav__search" id="search-wrap-mobile">
    <input type="search"
           class="search-input"
           id="search-input-mobile"
           placeholder="Search…"
           aria-label="Search posts"
           aria-expanded="false"
           aria-controls="search-results-mobile"
           autocomplete="off"
           spellcheck="false">
    <div class="search-results" id="search-results-mobile" role="listbox" aria-label="Search results"></div>
  </div>
  <% } %>
  <% navLinks.forEach(link => { %>
    <%
      const linkHref   = url_for(link.url).replace(/\/$/, '') || '/'
      const currentUrl = url_for('/' + page.path).replace(/\/index\.html$/, '').replace(/\/$/, '') || '/'
      const isActive   = currentUrl === linkHref
    %>
    <a href="<%- url_for(link.url) %>"
       class="nav-link<%= isActive ? ' active' : '' %>"
       <%= isActive ? 'aria-current="page"' : '' %>>
      <%= link.name %>
    </a>
  <% }) %>
</nav>
