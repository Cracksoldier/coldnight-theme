<%
  const ogImage    = page.cover_image || (theme.cover && theme.cover.default) || ''
  const ogImageAbs = ogImage ? full_url_for(ogImage) : ''
  // page_description (helpers.js) is the shared description → excerpt →
  // body-start chain, also consumed by the llms.txt generator
  const metaDesc   = (page_description(page) || config.description || '').slice(0, 160)
  const pageUrl    = (page.permalink || url).replace(/index\.html$/, '')
  // og:locale wants territory form (en_US); config.language is usually bare (en, de)
  const _langParts = (config.language || 'en').split(/[-_]/)
  const _ogBase    = _langParts[0].toLowerCase()
  const _OG_REGION = { en: 'US', zh: 'CN', ja: 'JP', ko: 'KR', sv: 'SE', da: 'DK', cs: 'CZ', el: 'GR', uk: 'UA' }
  const ogLocale   = _langParts.length > 1
    ? _ogBase + '_' + _langParts[1].toUpperCase()
    : _ogBase + '_' + (_OG_REGION[_ogBase] || _ogBase.toUpperCase())
  const metaKeywords = (page.tags && page.tags.length
    ? page.tags.toArray().map(function(t){ return t.name }).join(', ')
    : '') || config.keywords || ''

  let jsonLd = null
  if (page.layout === 'post') {
    const posting = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: page.title || '',
      datePublished: page.date.toISOString(),
      // mtime-based page.updated is "now" on fresh clones — only trust it when explicit
      dateModified: (has_explicit_updated(page) ? page.updated : page.date).toISOString(),
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      description: metaDesc
    }
    if (config.author) {
      posting.author = { '@type': 'Person', name: config.author }
      posting.publisher = { '@type': 'Person', name: config.author }
    }
    if (ogImageAbs) posting.image = ogImageAbs
    if (metaKeywords) posting.keywords = metaKeywords

    const crumbs = [{ '@type': 'ListItem', position: 1, name: 'Home', item: full_url_for('/') }]
    const firstCat = page.categories && page.categories.length ? page.categories.first() : null
    if (firstCat) {
      crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: firstCat.name, item: full_url_for(firstCat.path) })
    }
    // last crumb represents the current page — no `item`, per spec
    crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: page.title || '' })

    jsonLd = [posting, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs }]
  }
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
<meta name="description" content="<%= metaDesc %>">
<meta name="author" content="<%= config.author %>">
<% if (metaKeywords) { %>
<meta name="keywords" content="<%= metaKeywords %>">
<% } %>

<!-- Open Graph -->
<meta property="og:title" content="<%= page.title || config.title %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
<meta property="og:url" content="<%= pageUrl %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:locale" content="<%= ogLocale %>">
<% if (ogImageAbs) { %>
<meta property="og:image" content="<%= ogImageAbs %>">
<% } %>
<% if (page.layout === 'post') { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<meta property="article:author" content="<%= config.author %>">
<% } %>

<link rel="canonical" href="<%= pageUrl %>">

<% if (jsonLd) { %>
<!-- Structured data -->
<% jsonLd.forEach(function (obj) { %>
<script type="application/ld+json"><%- JSON.stringify(obj).replace(/</g, '\\u003c') %></script>
<% }) %>
<% } %>

<!-- Twitter Card -->
<meta name="twitter:card" content="<%= ogImageAbs ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= page.title || config.title %>">
<meta name="twitter:description" content="<%= metaDesc %>">
<% if (theme.social && theme.social.twitter) { %>
<meta name="twitter:site" content="@<%= theme.social.twitter %>">
<% } %>
<% if (ogImageAbs) { %>
<meta name="twitter:image" content="<%= ogImageAbs %>">
<% } %>

<!-- Favicon -->
<% const favicon = typeof theme.favicon === 'string' ? theme.favicon.trim() : '' %>
<% if (is_image_path(favicon)) { %>
<link rel="icon" type="<%= image_mime(favicon) %>" href="<%= url_for(favicon) %>">
<% } else { %>
<link rel="icon" type="image/svg+xml" href="<%- url_for('/favicon.svg') %>">
<link rel="alternate icon" href="<%- url_for('/favicon.ico') %>">
<% } %>

<!-- Fonts (self-hosted, latin + latin-ext) -->
<link rel="preload" href="<%- url_for('/fonts/roboto-latin-400-normal.woff2') %>" as="font" type="font/woff2" crossorigin>

<!-- Theme stylesheet -->
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>">

<% if (theme.view_transitions !== false) { %>
<!-- Cross-document View Transitions (progressive enhancement; inline because compiled SCSS can't read theme config) -->
<style>@media not (prefers-reduced-motion: reduce){@view-transition{navigation:auto}}</style>
<% } %>

<!-- LightGallery CSS — post pages only -->
<% if (page.layout === 'post' && theme.lightgallery && theme.lightgallery.enabled) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lightgallery.css') %>">
<% if (theme.lightgallery.zoom) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lg-zoom.css') %>">
<% } %>
<% if (theme.lightgallery.thumbnail) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lg-thumbnail.css') %>">
<% } %>
<% } %>

<!-- KaTeX CSS — post pages only -->
<% if (page.layout === 'post' && theme.math && theme.math.enabled) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/katex/katex.min.css') %>">
<% } %>

<!-- RSS -->
<% if (theme.social && theme.social.rss) { %>
<link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
<% } %>
<% if (theme.json_feed && theme.json_feed.enabled !== false) { %>
<link rel="alternate" type="application/feed+json" title="<%= config.title %>" href="<%- url_for('/feed.json') %>">
<% } %>
