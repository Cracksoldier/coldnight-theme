<%
  const ogImage    = page.cover_image || (theme.cover && theme.cover.default) || ''
  const ogImageAbs = ogImage ? config.url.replace(/\/$/, '') + url_for(ogImage) : ''
  const rawExcerpt = page.excerpt
    ? page.excerpt
        .replace(/<[^>]+>/g, '')
        .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&nbsp;/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
    : ''
  const metaDesc   = (page.description || rawExcerpt || config.description || '').slice(0, 160)
  const metaKeywords = (page.tags && page.tags.length
    ? page.tags.map(function(t){ return t.name }).join(', ')
    : '') || config.keywords || ''
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
<meta name="description" content="<%= metaDesc %>">
<meta name="author" content="<%= config.author %>">
<% if (metaKeywords) { %>
<meta name="keywords" content="<%= metaKeywords %>">
<% } %>

<!-- Open Graph -->
<meta property="og:title" content="<%= page.title || config.title %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
<meta property="og:url" content="<%= page.permalink || config.url %>">
<meta property="og:site_name" content="<%= config.title %>">
<% if (ogImageAbs) { %>
<meta property="og:image" content="<%= ogImageAbs %>">
<% } %>
<% if (page.layout === 'post') { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<meta property="article:author" content="<%= config.author %>">
<% } %>

<link rel="canonical" href="<%= page.permalink || config.url %>">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page.title || config.title %>">
<meta name="twitter:description" content="<%= metaDesc %>">
<% if (theme.social && theme.social.twitter) { %>
<meta name="twitter:site" content="@<%= theme.social.twitter %>">
<% } %>
<% if (ogImageAbs) { %>
<meta name="twitter:image" content="<%= ogImageAbs %>">
<% } %>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="<%- url_for('/favicon.svg') %>">
<link rel="alternate icon" href="<%- url_for('/favicon.ico') %>">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap">

<!-- Theme stylesheet -->
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>">

<!-- LightGallery CSS — post pages only -->
<% if (page.layout === 'post' && theme.lightgallery && theme.lightgallery.enabled) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lightgallery.css') %>">
<% if (theme.lightgallery.zoom) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lg-zoom.css') %>">
<% } %>
<% if (theme.lightgallery.thumbnail) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/lightgallery/lg-thumbnail.css') %>">
<% } %>
<% } %>

<!-- KaTeX CSS — post pages only -->
<% if (page.layout === 'post' && theme.math && theme.math.enabled) { %>
<link rel="stylesheet" href="<%- url_for('/vendor/katex/katex.min.css') %>">
<% } %>

<!-- RSS -->
<% if (theme.social && theme.social.rss) { %>
<link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
<% } %>
