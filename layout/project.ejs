<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="archive-wrapper">
  <main id="main-content" role="main">

    <a class="project-back" href="<%- url_for('/showroom/') %>">&#8592; Showroom</a>

    <% if (page.cover_image) { %>
      <div class="project-cover">
        <img src="<%- url_for(page.cover_image) %>" alt="<%= page.title %>">
      </div>
    <% } %>

    <h1><%= page.title %></h1>
    <% if (page.subtitle) { %>
      <p class="project-subtitle"><%= page.subtitle %></p>
    <% } %>
    <%- difficulty_meter(page, 'page') %>

    <div class="prose">
      <%- page.content %>
    </div>

  </main>
</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<script src="<%- url_for('/js/copy-code.js') %>" defer></script>

</body>
</html>
