<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>

<a href="#main-content" class="skip-nav">Skip to main content</a>

<%- partial('_partial/header') %>

<div class="archive-wrapper">
  <main id="main-content" role="main">

    <header class="page-header">
      <h1>Showroom</h1>
      <p class="page-header__meta"><%= page.total %> projects</p>
    </header>

    <%
      var hasAI    = page.projects.some(function(p) { return p.ai_assisted })
      var hasHuman = page.projects.some(function(p) { return !p.ai_assisted })
    %>
    <% if (hasAI && hasHuman) { %>
    <div class="archive-filters" role="group" aria-label="Filter projects">
      <button class="archive-filter-chip archive-filter-chip--active" data-filter-type="all" aria-pressed="true">All</button>
      <button class="archive-filter-chip" data-filter-type="ai" aria-pressed="false">AI-assisted</button>
      <button class="archive-filter-chip" data-filter-type="human" aria-pressed="false">Human-built</button>
    </div>
    <% } %>

    <div class="showroom-grid">
      <% page.projects.forEach(function(p) { %>
        <a class="project-card" href="<%- url_for(p.path) %>" data-ai="<%= !!p.ai_assisted %>">
          <% if (p.cover_image) { %>
          <img class="project-card__img" src="<%- url_for(p.cover_image) %>" alt="<%= p.title %>" loading="lazy">
          <% } %>
          <div class="project-card__overlay">
            <% if (p.ai_assisted) { %><span class="project-card__ai-badge">AI-assisted</span><% } %>
            <span class="project-card__title"><%= p.title %></span>
            <% if (p.subtitle) { %>
              <p class="project-card__subtitle"><%= p.subtitle %></p>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>

  </main>
</div>

<%- partial('_partial/footer') %>
<%- partial('_partial/toast') %>

<script src="<%- url_for('/js/nav.js') %>" defer></script>
<% if (hasAI && hasHuman) { %>
<script src="<%- url_for('/js/showroom-filter.js') %>" defer></script>
<% } %>

</body>
</html>
