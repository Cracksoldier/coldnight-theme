// ─── Code Blocks ─────────────────────────────────────────────────────────────

.post-body, .prose
  pre
    background bg-elevated
    border 1px solid border-subtle
    border-radius radius
    padding 1rem
    overflow-x auto
    margin 1rem 0
    position relative

  code
    font-family unquote(font-mono)
    font-size 0.875rem
    color text-primary

  pre code
    background none
    border none
    padding 0
    font-size 0.875rem
    color text-primary

  // Inline code
  :not(pre) > code
    font-family unquote(font-mono)
    font-size 0.875em
    background bg-elevated
    color accent-light
    padding 0.15em 0.4em
    border-radius 4px
    border 1px solid border-subtle

// hljs wrapper (Hexo wraps in figure.highlight)
figure.highlight
  background bg-elevated
  border 1px solid border-subtle
  border-radius radius
  margin 1rem 0
  overflow hidden
  position relative

  table
    margin 0
    border none
    width 100%

  th, td
    border none
    padding 0

  .gutter
    user-select none
    padding 1rem 0.5rem
    background rgba(0, 0, 0, 0.15)
    color text-muted
    font-size 0.8rem
    font-family unquote(font-mono)
    text-align right
    min-width 36px

  .code
    padding 0

  pre
    margin 0
    border none
    background none
    padding 1rem

// Language label
figure.highlight::before
  content attr(data-lang)
  position absolute
  top 0
  right 0
  font-size 12px
  color text-muted
  background bg-input
  padding 2px 8px
  border-radius 0 radius 0 6px
  font-family unquote(font-mono)
  text-transform lowercase
  pointer-events none

// Copy button (injected by copy-code.js)
.code-copy-btn
  position absolute
  top 8px
  left 10px
  opacity 0
  transition opacity transition-fast

figure.highlight:hover .code-copy-btn
  opacity 1

// ─── Highlight.js dark-mode span overrides ────────────────────────────────────
// Base tones from GitHub-Light adjusted for dark bg readability

.hljs-comment,
.hljs-quote
  color #8b949e
  font-style italic

.hljs-keyword,
.hljs-selector-tag
  color #ff7b72

.hljs-number,
.hljs-string,
.hljs-meta .hljs-meta-string,
.hljs-literal,
.hljs-doctag,
.hljs-regexp
  color #a5d6ff

.hljs-title,
.hljs-section,
.hljs-name,
.hljs-selector-id,
.hljs-selector-class
  color #d2a8ff

.hljs-attribute,
.hljs-attr,
.hljs-variable,
.hljs-template-variable,
.hljs-class .hljs-title,
.hljs-type
  color #ffa657

.hljs-symbol,
.hljs-bullet,
.hljs-subst,
.hljs-meta,
.hljs-meta .hljs-keyword,
.hljs-selector-attr,
.hljs-selector-pseudo,
.hljs-link
  color #79c0ff

.hljs-built_in
  color #ffa198

.hljs-formula
  color #a5d6ff

.hljs-emphasis
  font-style italic

.hljs-strong
  font-weight bold

// Diff highlighting — full-line colored backgrounds
.hljs-addition
  display block
  background rgba(16, 185, 129, 0.15)
  margin 0 -1rem
  padding 0 1rem
  color #7ee8a2

.hljs-deletion
  display block
  background rgba(239, 68, 68, 0.12)
  margin 0 -1rem
  padding 0 1rem
  color #ffa198

// Marked lines — {% codeblock lang mark:1,3-5 %}
figure.highlight .marked
  display block
  background rgba(37, 99, 235, 0.18)
  border-left 3px solid accent
  margin 0 -1rem
  padding 0 1rem 0 calc(1rem - 3px)
